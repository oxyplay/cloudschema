AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-key
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_API_VERSION=2024-10-21

AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_FOUNDRY_PROJECT_NAME=your-project
FOUNDRY_IQ_KNOWLEDGE_SOURCE_NAME=cloudschema-knowledge-base

# Optional real retrievable grounding source for standards. If omitted, the app falls back to foundry_iq_knowledge/company_standards.md.
AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_AI_SEARCH_KEY=your-search-admin-or-query-key
AZURE_AI_SEARCH_INDEX_NAME=cloudschema-standards
AZURE_AI_SEARCH_CONTENT_FIELD=content
AZURE_AI_SEARCH_TITLE_FIELD=title

# Optional Azure Resource Manager validation. DefaultAzureCredential can use `az login`.
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=rg-cloudschema-demo
AZURE_LOCATION=eastus

# Optional for Azure Static Web Apps / server deployment
NITRO_PRESET=node-server
